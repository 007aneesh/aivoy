# --- Clerk (https://dashboard.clerk.com) -----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Postgres (Neon for prod, local for dev) -------------------------------
# Local dev: docker compose up -d
DATABASE_URL=postgres://aivoy:aivoy@localhost:5433/aivoy

# --- Server-side encryption -------------------------------------------------
# Generate once with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tenant API keys are sealed with this master key. Rotating it requires
# re-encrypting every row in provider_credentials.
AIVOY_MASTER_KEY=base64-encoded-32-byte-key

# --- App URLs ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
