{
  "name": "aivoy-monorepo",
  "private": true,
  "version": "0.1.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev:cloud": "pnpm --filter @aivoy/cloud dev",
    "dev:pkg": "pnpm --filter aivoy dev",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @aivoy/cloud db:generate",
    "db:migrate": "pnpm --filter @aivoy/cloud db:migrate",
    "db:studio": "pnpm --filter @aivoy/cloud db:studio"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.1.0"
}
